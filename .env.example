# --- Telegram ---
TELEGRAM_TOKEN=your_bot_token

# --- Шифрование секретов ---
# 32 байта в base64. Сгенерировать: openssl rand -base64 32
MASTER_KEY=

# --- PostgreSQL ---
# Используйте длинный случайный пароль: openssl rand -base64 24
# В docker compose пароль применяется только при первой инициализации тома
# pgdata; для существующей БД меняйте его через ALTER USER.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=totpbot
DB_SSLMODE=disable

# --- Redis ---
# Обязателен для docker compose. Сгенерировать: openssl rand -base64 24
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Поведение ---
ENABLE_GROUPS=true
LOG_LEVEL=info

# --- Воркер-пул обработки апдейтов ---
WORKER_SHARDS=8
WORKER_QUEUE_SIZE=64
